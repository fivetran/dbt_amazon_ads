name: 'Check merge ready'
on:
  pull_request:
    types: [labeled, unlabeled]

jobs:
  check-label:
    runs-on: ubuntu-latest
    steps:
      - name: Report merge-ready status
        run: |
          LABELS=$(curl -s \
            -H "Authorization: token ${{ secrets.GH_TOKEN }}" \
            "https://api.github.com/repos/${{ github.repository }}/issues/${{ github.event.pull_request.number }}/labels" \
            | jq -r '.[].name')

          if echo "$LABELS" | grep -q "merge:ready"; then
            STATE="success"
            DESC="merge:ready label applied"
          else
            STATE="failure"
            DESC="Waiting for merge:ready label"
          fi

          curl -X POST \
            -H "Authorization: token ${{ secrets.GH_TOKEN }}" \
            "https://api.github.com/repos/${{ github.repository }}/statuses/${{ github.event.pull_request.head.sha }}" \
            -d "{
              \"state\": \"$STATE\",
              \"context\": \"label/merge-ready\",
              \"description\": \"$DESC\"
            }"
