#!/bin/bash

# Post-checkout hook to configure and load centralized pipeline (runs after checkout)
set -euo pipefail

echo "Loading pipeline.yml..."

# Set enabled warehouses for this package (as array)
buildkite-agent env set ENABLED_WAREHOUSES='["postgres", "snowflake"]'

# Download the central pipeline (use as-is)
curl -f -s https://raw.githubusercontent.com/fivetran/dbt_package_automations/feature/centralized-bk/.buildkite/pipeline.yml \
    -o .buildkite/pipeline.yml

echo "pipeline.yml loaded successfully."