#!/bin/bash

# Post-checkout hook to configure and load centralized pipeline (runs after checkout)
set -euo pipefail

echo "Generating centralized pipeline..."

buildkite-agent env set ENABLED_WAREHOUSES "postgres snowflake"

curl -fsSL \
  https://raw.githubusercontent.com/fivetran/dbt_package_automations/feature/centralized-bk/.buildkite/scripts/bootstrap_pipeline.sh \
  | bash

echo "Centralized pipeline generated."