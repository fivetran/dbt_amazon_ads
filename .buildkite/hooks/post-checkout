#!/bin/bash

# Post-checkout hook to configure and load centralized pipeline (runs after checkout)
set -euo pipefail

echo "Configuring central pipeline"

# Download the central pipeline template
curl -f -s https://raw.githubusercontent.com/fivetran/dbt_package_automations/feature/centralized-bk/.buildkite/pipeline.yml \
    -o .buildkite/pipeline_base.yml

# Create pipeline with merged env section
cat > .buildkite/pipeline.yml << EOF
env:
  RUN_MODELS_URL: "https://raw.githubusercontent.com/fivetran/dbt_package_automations/refs/heads/feature/centralized-bk/.buildkite/scripts/run_models.sh"
  TEST_POSTGRES: true
  TEST_SNOWFLAKE: false
  TEST_BIGQUERY: false
  TEST_REDSHIFT: false
  TEST_DATABRICKS: false
  TEST_DATABRICKS_SQL: false
  TEST_SQLSERVER: false

EOF

# Append the steps section (skip the env section)
tail -n +4 .buildkite/pipeline_base.yml >> .buildkite/pipeline.yml

# Clean up temp file
rm -f .buildkite/pipeline_base.yml

echo "Central pipeline configured."